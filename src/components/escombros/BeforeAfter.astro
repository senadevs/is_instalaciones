---
// Comparador antes/después (effects-pro.md §Before after slider): input range accesible
// (teclado, lector, táctil) + clip-path animado en compositor. Funciona sin JS pesado.
// FOTOS PROVISIONALES: sustituir por un antes/después real de retirada de escombros.
import { Icon } from 'astro-icon/components';
---
<section class="theme-escombros border-b border-[color:var(--esc-border)] py-20 sm:py-28">
  <div class="container mx-auto px-4">
    <div class="mb-12 max-w-2xl">
      <h2 class="font-[Outfit,system-ui,sans-serif] text-3xl font-bold tracking-tight sm:text-5xl">
        Así queda tu obra <span class="text-[color:var(--esc-accent)]">cuando nos vamos</span>
      </h2>
      <p class="mt-4 text-lg text-[color:var(--esc-text-muted)]">
        Arrastra el comparador: mismo espacio, antes y después de la retirada y la limpieza fin de obra.
      </p>
    </div>

    <div class="esc-ba relative mx-auto max-w-5xl overflow-hidden rounded-2xl border border-[color:var(--esc-border)]" style="--pos: 50%">
      <img
        class="block aspect-[16/10] w-full object-cover"
        src="/trabajos/reforma-integral-obra-proceso.jpeg"
        alt="Obra en proceso con escombros y material acumulado"
        width="1600"
        height="1000"
        loading="lazy"
      />
      <img
        class="esc-ba-after absolute inset-0 aspect-[16/10] h-full w-full object-cover"
        src="/trabajos/reforma-salon-cocina-parquet.jpeg"
        alt="El mismo tipo de espacio, limpio y terminado tras la retirada"
        width="1600"
        height="1000"
        loading="lazy"
      />

      <span class="pointer-events-none absolute left-4 top-4 z-[2] rounded-md bg-black/70 px-3 py-1 text-sm font-semibold text-white">Antes</span>
      <span class="pointer-events-none absolute right-4 top-4 z-[2] rounded-md bg-primary px-3 py-1 text-sm font-semibold text-white">Después</span>

      <div class="esc-ba-line pointer-events-none absolute inset-y-0 z-[2] w-0.5 bg-white/90" aria-hidden="true">
        <span class="absolute left-1/2 top-1/2 grid h-11 w-11 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full bg-white text-[color:var(--esc-surface)] shadow-lg">
          <Icon name="lucide:chevrons-left-right" class="h-5 w-5" aria-hidden="true" />
        </span>
      </div>

      <label class="sr-only" for="esc-ba-range">Comparar antes y después de la limpieza de obra</label>
      <input id="esc-ba-range" class="esc-ba-range" type="range" min="0" max="100" value="50" />
    </div>
  </div>
</section>

<style>
  .esc-ba-after { clip-path: inset(0 calc(100% - var(--pos)) 0 0); }
  .esc-ba-line { left: var(--pos); transform: translateX(-50%); }
  .esc-ba-range {
    position: absolute;
    inset: 0;
    z-index: 3;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: ew-resize;
  }
  .esc-ba-range:focus-visible ~ * { outline: none; }
  .esc-ba:has(.esc-ba-range:focus-visible) { outline: 2px solid var(--esc-accent); outline-offset: 3px; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.esc-ba').forEach((root) => {
    const range = root.querySelector<HTMLInputElement>('.esc-ba-range');
    if (!range) return;
    range.addEventListener('input', () => root.style.setProperty('--pos', `${range.value}%`));
  });
</script>
