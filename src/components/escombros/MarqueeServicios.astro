---
// Marquee infinito de servicios (effects-pro.md §Marquee infinito): dos mitades idénticas,
// la segunda aria-hidden; pausa al pasar el puntero; en reduced-motion queda estático.
const items = [
  'Contenedores de obra',
  'Sacas de escombros',
  'Retirada y transporte',
  'Limpieza fin de obra',
  'Vaciado de pisos y locales',
  'Gestión de residuos',
];
const group = items.map((i) => `${i}`).join('  ·  ') + '  ·  ';
---
<div class="theme-escombros esc-marquee border-b border-[color:var(--esc-border)] py-5" data-marquee aria-label="Servicios de escombros">
  <div class="esc-marquee-track font-[Outfit_Variable,system-ui,sans-serif] text-2xl font-semibold uppercase tracking-wide text-[color:var(--esc-text-muted)] sm:text-3xl">
    <div class="esc-marquee-group">{group}</div>
    <div class="esc-marquee-group" aria-hidden="true">{group}</div>
  </div>
</div>

<style>
  .esc-marquee { overflow: hidden; }
  .esc-marquee-track { display: flex; width: max-content; white-space: pre; }
  .esc-marquee-group { flex-shrink: 0; padding-right: 1ch; }
</style>

<script>
  import { gsap } from '../../lib/gsap';

  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((root) => {
    gsap.context(() => {
      const mm = gsap.matchMedia();
      mm.add('(prefers-reduced-motion: no-preference)', () => {
        const track = root.querySelector<HTMLElement>('.esc-marquee-track');
        if (!track) return;
        const speed = 70; // px/s
        const tween = gsap.to(track, { xPercent: -50, ease: 'none', repeat: -1, duration: track.scrollWidth / 2 / speed });
        const pause = () => gsap.to(tween, { timeScale: 0, duration: 0.4 });
        const play = () => gsap.to(tween, { timeScale: 1, duration: 0.4 });
        root.addEventListener('pointerenter', pause);
        root.addEventListener('pointerleave', play);
        return () => {
          root.removeEventListener('pointerenter', pause);
          root.removeEventListener('pointerleave', play);
        };
      });
    }, root);
  });
</script>
