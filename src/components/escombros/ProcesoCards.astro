---
// Proceso en stacking cards sticky (effects-pro.md §Stacking cards completo): cada card se
// degrada (escala/rotación) mientras la siguiente la cubre. Blur solo en desktop; en
// reduced-motion queda como lista sticky legible sin tweens.
import { Icon } from 'astro-icon/components';

const pasos = [
  {
    icon: 'lucide:clipboard-list',
    title: 'Visita y presupuesto cerrado',
    text: 'Vemos la obra (o nos mandas fotos por WhatsApp), calculamos el volumen y te damos un precio cerrado por adelantado. Sin sorpresas al final.',
    img: '/trabajos/reforma-obra-albanileria-equipo.jpeg',
  },
  {
    icon: 'lucide:container',
    title: 'Contenedor o sacas en tu obra',
    text: 'Colocamos el contenedor o las sacas donde te venga bien, con los permisos de ocupación de vía pública gestionados por nosotros si hacen falta.',
    img: '/trabajos/reforma-pladur-proceso-equipo.jpeg',
  },
  {
    icon: 'lucide:truck',
    title: 'Retirada y transporte',
    text: 'Nuestro equipo carga y retira los escombros en la fecha acordada. Si la obra sigue, hacemos recogidas periódicas para que nunca pares.',
    img: '/trabajos/reforma-integral-obra-proceso.jpeg',
  },
  {
    icon: 'lucide:recycle',
    title: 'Gestión y reciclaje del residuo',
    text: 'Llevamos el residuo a planta de tratamiento autorizada y te entregamos el justificante de gestión, listo para tu licencia de obra.',
    img: '/trabajos/reforma-salon-cocina-parquet.jpeg',
  },
];
---
<section class="theme-escombros border-b border-[color:var(--esc-border)] py-20 sm:py-28">
  <div class="container mx-auto px-4">
    <div class="mb-14 max-w-2xl">
      <h2 class="font-[Outfit,system-ui,sans-serif] text-3xl font-bold tracking-tight sm:text-5xl">
        De obra llena a obra limpia <span class="text-[color:var(--esc-accent)]">en 4 pasos</span>
      </h2>
    </div>

    <div class="esc-stack mx-auto grid max-w-4xl gap-16" data-esc-stack>
      {pasos.map((p, i) => (
        <article class="esc-stack-card overflow-hidden rounded-3xl border border-[color:var(--esc-border)] bg-[color:var(--esc-surface)]">
          <div class="grid min-h-[60vh] sm:grid-cols-2">
            <div class="flex flex-col justify-center gap-4 p-8 sm:p-12">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary text-white">
                <Icon name={p.icon} class="h-6 w-6" aria-hidden="true" />
              </span>
              <p class="text-sm font-semibold uppercase tracking-widest text-[color:var(--esc-accent)]">Paso {i + 1} de {pasos.length}</p>
              <h3 class="font-[Outfit,system-ui,sans-serif] text-2xl font-bold sm:text-3xl">{p.title}</h3>
              <p class="text-[color:var(--esc-text-muted)]">{p.text}</p>
            </div>
            <div class="relative min-h-[220px]">
              <img src={p.img} alt="" width="800" height="600" class="absolute inset-0 h-full w-full object-cover" loading="lazy" />
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .esc-stack-card { position: sticky; top: 10vh; }
</style>

<script>
  import { gsap } from '../../lib/gsap';

  document.querySelectorAll<HTMLElement>('[data-esc-stack]').forEach((root) => {
    gsap.context(() => {
      const cards = gsap.utils.toArray<HTMLElement>('.esc-stack-card');
      const mm = gsap.matchMedia();
      mm.add(
        {
          desktop: '(min-width: 768px) and (prefers-reduced-motion: no-preference)',
          mobile: '(max-width: 767px) and (prefers-reduced-motion: no-preference)',
        },
        (ctx) => {
          const { desktop } = ctx.conditions as { desktop: boolean };
          cards.forEach((card, i) => {
            if (i === cards.length - 1) return; // la última nunca se tapa
            gsap.to(card, {
              scale: 0.93,
              rotation: (i % 2 ? 1 : -1) * 1.1,
              filter: desktop ? 'blur(4px)' : 'none', // blur fuerza repaint: solo desktop
              transformOrigin: 'center top',
              ease: 'none',
              scrollTrigger: { trigger: cards[i + 1], start: 'top bottom', end: 'top top', scrub: true },
            });
          });
        }
      );
    }, root);
  });
</script>
