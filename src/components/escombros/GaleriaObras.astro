---
// Galería con skew-on-scroll (effects-pro.md §Scroll velocity skew): las imágenes se
// inclinan según la velocidad de scroll. Solo con puntero fino y sin reduced-motion.
// FOTOS PROVISIONALES: obras reales del equipo; sustituir por trabajos de escombros.
const fotos = [
  { src: '/trabajos/reforma-integral-obra-proceso.jpeg', alt: 'Obra integral en proceso con material y escombros' },
  { src: '/trabajos/reforma-obra-albanileria-equipo.jpeg', alt: 'Equipo de albañilería trabajando en obra' },
  { src: '/trabajos/reforma-pladur-proceso-equipo.jpeg', alt: 'Montaje de pladur durante una reforma' },
  { src: '/trabajos/pladur-bano.jpeg', alt: 'Baño en obra durante la reforma' },
  { src: '/trabajos/reforma-electricidad.jpeg', alt: 'Instalación eléctrica renovada en obra' },
  { src: '/trabajos/reforma-salon-cocina-parquet.jpeg', alt: 'Salón cocina terminado tras la obra' },
];
---
<section class="theme-escombros border-b border-[color:var(--esc-border)] py-20 sm:py-28" data-esc-galeria>
  <div class="container mx-auto px-4">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-6">
      <h2 class="max-w-xl font-[Outfit_Variable,system-ui,sans-serif] text-3xl font-bold tracking-tight sm:text-5xl">
        Obras donde ya <span class="text-[color:var(--esc-accent)]">hemos pasado</span>
      </h2>
      <p class="max-w-md text-[color:var(--esc-text-muted)]">
        El mismo equipo que hace la reforma se lleva los escombros: coordinación total y una sola factura.
      </p>
    </div>

    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {fotos.map((f) => (
        <li class="overflow-hidden rounded-2xl border border-[color:var(--esc-border)]">
          <img
            src={f.src}
            alt={f.alt}
            width="800"
            height="600"
            class="esc-skew-item aspect-[4/3] w-full object-cover"
            loading="lazy"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<script>
  import { gsap, ScrollTrigger } from '../../lib/gsap';

  document.querySelectorAll<HTMLElement>('[data-esc-galeria]').forEach((root) => {
    gsap.context(() => {
      const mm = gsap.matchMedia();
      mm.add('(pointer: fine) and (prefers-reduced-motion: no-preference)', () => {
        gsap.set('.esc-skew-item', { transformOrigin: 'center center', force3D: true });
        const skewTo = gsap.quickTo('.esc-skew-item', 'skewY', { duration: 0.5, ease: 'power3.out', unit: 'deg' });
        const st = ScrollTrigger.create({ onUpdate: (self) => skewTo(gsap.utils.clamp(-6, 6, self.getVelocity() / -350)) });
        const settle = () => skewTo(0); // el último evento puede dejar skew residual
        ScrollTrigger.addEventListener('scrollEnd', settle);
        return () => { ScrollTrigger.removeEventListener('scrollEnd', settle); st.kill(); };
      });
    }, root);
  });
</script>
