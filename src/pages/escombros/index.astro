---
// Landing del subdominio de escombros. Diseño "industrial oscuro" según
// design-system/is-escombros/MASTER.md (paleta de marca IS + Outfit/Work Sans).
import '@fontsource-variable/outfit';
import '@fontsource-variable/work-sans';
import Layout from '../../layouts/Layout.astro';
import EscombrosHero from '../../components/escombros/EscombrosHero.astro';
import MarqueeServicios from '../../components/escombros/MarqueeServicios.astro';
import BeforeAfter from '../../components/escombros/BeforeAfter.astro';
import Contadores from '../../components/escombros/Contadores.astro';
import ProcesoCards from '../../components/escombros/ProcesoCards.astro';
import GaleriaObras from '../../components/escombros/GaleriaObras.astro';
import ContactSection from '../../components/contact/ContactSection.astro';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Retirada de escombros y limpieza de obra',
  serviceType: 'Retirada de escombros',
  areaServed: { '@type': 'City', name: 'Barcelona' },
  provider: { '@id': 'https://is-instalaciones.es#localbusiness' },
  description:
    'Contenedores, sacas y retirada de escombros en Barcelona con transporte y gestión del residuo en planta autorizada. Presupuesto cerrado y justificante de gestión.',
};
---
<Layout
  title="Retirada de Escombros en Barcelona | Contenedores y Sacas | IS Instalaciones"
  description="Retirada de escombros en Barcelona: contenedores de obra, sacas, limpieza fin de obra y vaciado de pisos con gestión del residuo en planta autorizada. Presupuesto cerrado en 24 h."
  keywords={[
    'retirada de escombros barcelona',
    'contenedores de escombros barcelona',
    'sacas de escombros barcelona',
    'limpieza fin de obra barcelona',
    'vaciado de pisos barcelona',
    'gestion de residuos de obra barcelona',
    'alquiler contenedor obra barcelona',
  ]}
  additionalSchema={serviceSchema}
>
  <!-- Tipografías del design system de escombros (autoalojadas, importadas arriba) -->
  <main class="theme-escombros font-[Work_Sans_Variable,system-ui,sans-serif]">
    <EscombrosHero />
    <MarqueeServicios />
    <BeforeAfter />
    <Contadores />
    <ProcesoCards />
    <GaleriaObras />

    <section id="contacto" class="bg-white text-theme">
      <ContactSection />
    </section>
  </main>
</Layout>
