---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/sections/Hero.astro';
import ContactSection from '../components/contact/ContactSection.astro';
import CTARenovations from '../components/cta/CTARenovations.astro';
import CTAServices from '../components/cta/CTAServices.astro';
import GlitchSlider from '../components/sections/GlitchSlider.astro';
import HowWeWork from '../components/sections/HowWeWork.astro';

const homeSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Instalaciones y reformas en Barcelona',
  serviceType: [
    'Instalaciones eléctricas',
    'Fontanería y saneamiento',
    'Climatización y calefacción',
    'Reformas integrales'
  ],
  provider: { '@id': 'https://is-instalaciones.es#localbusiness' },
  areaServed: {
    '@type': 'AdministrativeArea',
    name: 'Barcelona y área metropolitana'
  },
  availableChannel: [
    {
      '@type': 'ServiceChannel',
      serviceUrl: 'https://is-instalaciones.es/contacto'
    },
    {
      '@type': 'ServiceChannel',
      serviceUrl: 'https://is-instalaciones.es/estimador'
    }
  ]
};
---

<Layout
  title="Instalaciones y Reformas en Barcelona | IS Instalaciones"
  description="Instalaciones y reformas en Barcelona: electricidad, fontanería, climatización y reformas integrales. Técnicos autorizados y 2 años de garantía."
  additionalSchema={homeSchema}
>
	<Hero />
	<CTAServices />
	<GlitchSlider />
	<CTARenovations />
	<HowWeWork />
	<ContactSection />
</Layout>
