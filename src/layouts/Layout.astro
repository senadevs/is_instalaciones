---
import { AREA_SERVED, BUSINESS_ID, GOOGLE_BUSINESS_URL, SITE_URL } from '../data/negocio';

interface Crumb {
  name: string;
  path: string;
}

interface Props {
  title: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  additionalSchema?: object | object[];
  /** Migas para BreadcrumbList. Si no se pasan, se deducen de la URL y del title. */
  breadcrumbs?: Crumb[];
  hideFooter?: boolean;
  hideBanner?: boolean;
}

// Sin <meta name="keywords">: Google la ignora y solo enseña las keywords a la competencia (F6-T2).
const {
  title = 'Instalaciones y Reformas en Barcelona | IS Instalaciones',
  description = 'Instalaciones y reformas en Barcelona: electricidad, fontanería, climatización y reformas integrales. Técnicos autorizados y 2 años de garantía.',
  image = '/img/logo.webp',
  noindex = false,
  additionalSchema,
  breadcrumbs,
  hideFooter = false,
  hideBanner = false
} = Astro.props;

const siteUrl = SITE_URL;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const imageUrl = new URL(image, siteUrl).toString();

// Negocio de zona de servicio (sin local): dirección solo con localidad, sin calle, CP ni coordenadas.
const businessSchema = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': BUSINESS_ID,
  name: 'IS Instalaciones',
  image: new URL('/img/logo.webp', siteUrl).toString(),
  logo: new URL('/img/logo.webp', siteUrl).toString(),
  url: `${siteUrl}/`,
  telephone: '+34637591736',
  email: 'isinstalacionesbcn@gmail.com',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Barcelona',
    addressRegion: 'Cataluña',
    addressCountry: 'ES'
  },
  hasMap: GOOGLE_BUSINESS_URL,
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '09:00',
      closes: '18:00'
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: 'Saturday',
      opens: '09:00',
      closes: '14:00'
    }
  ],
  areaServed: AREA_SERVED,
  sameAs: [GOOGLE_BUSINESS_URL],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Servicios de instalaciones y reformas',
    itemListElement: [
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Instalaciones eléctricas',
          description: 'Instalaciones eléctricas, cuadros, boletines y modernización de viviendas y locales en Barcelona.'
        }
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Fontanería y saneamiento',
          description: 'Fontanería, fugas, tuberías, calderas y saneamiento para viviendas y negocios.'
        }
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Climatización y calefacción',
          description: 'Instalación y mantenimiento de aire acondicionado, calefacción y ventilación.'
        }
      },
      {
        '@type': 'Offer',
        itemOffered: {
          '@type': 'Service',
          name: 'Reformas integrales',
          description: 'Reformas completas de pisos, cocinas, baños, oficinas y locales comerciales.'
        }
      }
    ]
  }
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  url: siteUrl,
  name: 'IS Instalaciones',
  inLanguage: 'es-ES',
  publisher: { '@id': BUSINESS_ID }
};

// BreadcrumbList: Inicio > secciones intermedias que existen como página > página actual (con el title
// sin la marca). Ni en la home ni en páginas noindex.
const SECCIONES: Record<string, string> = { servicios: 'Servicios' };
const segmentos = Astro.url.pathname.split('/').filter(Boolean);
const migas: Crumb[] =
  breadcrumbs ??
  [
    { name: 'Inicio', path: '/' },
    ...segmentos
      .slice(0, -1)
      .map((seg, i) => ({ seg, path: `/${segmentos.slice(0, i + 1).join('/')}/` }))
      .filter(({ seg }) => SECCIONES[seg])
      .map(({ seg, path }) => ({ name: SECCIONES[seg], path })),
    { name: title.split(' | ')[0].trim(), path: Astro.url.pathname }
  ];
const breadcrumbSchema =
  segmentos.length && !noindex
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: migas.map((miga, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: miga.name,
          item: new URL(miga.path, siteUrl).toString()
        }))
      }
    : undefined;
const extraSchemas = additionalSchema ? [additionalSchema].flat() : [];

import Footer from '../components/ui/Footer.astro';
import Header from '../components/ui/Header.astro';
import ChatBubble from '../components/ui/ChatBubble.astro';
import AnnouncementBanner from '../components/ui/AnnouncementBanner.astro';
import CookieBanner from '../components/ui/CookieBanner.astro';
import AnalyticsEvents from '../components/ui/AnalyticsEvents.astro';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script is:inline>window.dataLayer = window.dataLayer || [];</script>
    <script is:inline>
      const theme = localStorage.getItem('theme') || 'default';
      document.documentElement.setAttribute('data-theme', theme);
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="IS Instalaciones" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="googlebot" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <meta name="theme-color" content="#046a53" />

    <link rel="alternate" type="text/plain" title="LLM Context" href="/llm.txt" />
    <link rel="alternate" type="text/plain" title="LLMs Context" href="/llms.txt" />
    <meta name="ai-content" content="Professional renovation and installation services in Barcelona. Licensed technicians, free quotes and 2-year warranty." />

    <meta name="geo.region" content="ES-CT" />
    <meta name="geo.placename" content="Barcelona" />

    <meta property="og:locale" content="es_ES" />
    <link rel="alternate" hreflang="es-ES" href={canonicalURL} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/webp" sizes="any" href="/img/logo.webp" />
    <link rel="apple-touch-icon" href="/img/logo.webp" />
    <link rel="manifest" href="/site.manifest" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content="IS Instalaciones, servicios de instalaciones y reformas en Barcelona" />
    <meta property="og:site_name" content="IS Instalaciones" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content="IS Instalaciones, servicios de instalaciones y reformas en Barcelona" />

    <script type="application/ld+json" set:html={JSON.stringify(businessSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    {extraSchemas.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <Header />
    <slot />
    {!hideFooter && <Footer />}
    <ChatBubble />
    {!hideBanner && <AnnouncementBanner />}
    <CookieBanner />
    <AnalyticsEvents />
    <script is:inline>
      function initScrollAnimations() {
        const elements = document.querySelectorAll('[data-animate]');
        if (!elements.length) return;

        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          });
        }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });

        elements.forEach((el) => observer.observe(el));

        document.querySelectorAll('[data-stagger]').forEach((container) => {
          const children = container.querySelectorAll(':scope > [data-animate]');
          children.forEach((child, i) => {
            child.style.setProperty('--stagger-index', String(i));
          });
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initScrollAnimations);
      } else {
        initScrollAnimations();
      }

      document.addEventListener('astro:page-load', initScrollAnimations);
    </script>
  </body>
</html>
