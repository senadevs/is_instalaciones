# Variables de entorno de IS Instalaciones. Copia a .env y rellena los valores (no subas .env a git).

# Chat (src/pages/api/chat.ts) - API de NVIDIA (https://build.nvidia.com)
NVIDIA_API_KEY=
# Opcional: modelos a probar en orden, separados por comas. Por defecto: openai/gpt-oss-20b
NVIDIA_CHAT_MODEL=

# Reseñas de Google (src/pages/api/reviews.ts)
GOOGLE_API_KEY=
GOOGLE_PLACE_ID=
